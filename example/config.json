{
  "Log": {
    "Level": "info",
    "Output": ""
  },
  "Cores": [
    {
      "Type": "sing",
      "Log": {
        "Level": "info",
        "Timestamp": true
      },
      "NTP": {
        "Enable": true,
        "Server": "time.apple.com",
        "ServerPort": 0
      },
      "OriginalPath": "/etc/N2X/sing_origin.json"
    }
  ],
  "Nodes": [
    {
      "Core": "sing",
      "ApiHost": "${N2X_API_HOST:-http://127.0.0.1}",
      "ApiKey": "${N2X_API_KEY}",
      "NodeID": 33,
      "NodeType": "shadowsocks",
      "Timeout": 30,
      // Optional X-Board WebSocket driver. Leave Enabled=false (default)
      // to stay on pure HTTP polling. When enabled, URL is derived from
      // ApiHost automatically (http -> ws, https -> wss, path /ws/),
      // or set it explicitly to override. Debug=true prints every event
      // to the log and is useful when commissioning a new panel.
      "WebSocket": {
        "Enabled": false,
        "URL": "",
        "Debug": false
      },
      "ListenIP": "0.0.0.0",
      "SendIP": "0.0.0.0",
      "DeviceOnlineMinTraffic": 200,
      "MinReportTraffic": 0,
      "TCPFastOpen": false,
      "SniffEnabled": true,
      "CertConfig": {
        "CertMode": "none",
        "RejectUnknownSni": false,
        "CertDomain": "all.example.com",
        "CertFile": "/etc/N2X/fullchain.cer",
        "KeyFile": "/etc/N2X/cert.key",
        "Email": "example@gmail.com",
        "Provider": "cloudflare",
        "DNSEnv": {
          "CF_API_KEY": "ExampleKEY",
          "CLOUDFLARE_EMAIL": "example@gmail.com"
        }
      }
    }
  ]
}
